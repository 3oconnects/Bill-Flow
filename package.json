{
  "name": "ozofibooks-pro",
  "version": "1.0.0",
  "description": "Ozofi Books Pro - Zoho Books-style billing platform",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon backend/server.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:frontend": "npm install --prefix frontend && npm run build --prefix frontend",
    "test": "npm run test:backend",
    "test:backend": "jest --testMatch='**/backend/tests/**/*.test.js' --forceExit --detectOpenHandles",
    "test:coverage": "jest --testMatch='**/backend/tests/**/*.test.js' --coverage --forceExit",
    "db:migrate": "node backend/db/migrate.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.18.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "razorpay": "^2.9.2",
    "redis": "^4.7.0",
    "resend": "^6.20.0",
    "stripe": "^22.5.0",
    "supertest": "^7.2.2",
    "uuid": "^9.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "jest": "^29.7.0",
    "nodemon": "^3.0.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/backend/tests/**/*.test.js"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
